# ═══════════════════════════════════════════════════════════════════
# EBM Analyzer – Umgebungsvariablen (Vorlage)
# Kopieren nach .env und Werte anpassen. .env NIEMALS committen!
# ═══════════════════════════════════════════════════════════════════

# ── Datenbank ───────────────────────────────────────────────────────
# POSTGRES_USER/PASSWORD ist der Cluster-Bootstrap-Superuser (nur für
# Migrationen). APP_DB_PASSWORD gehört zur eingeschränkten Rolle ebm_app,
# über die die App zur Laufzeit läuft, damit Row-Level-Security überhaupt
# greift — Superuser umgehen RLS grundsätzlich.
POSTGRES_USER=ebm_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password
APP_DB_PASSWORD=CHANGE_ME_different_strong_password

# ── Backups ─────────────────────────────────────────────────────────
# Nur PostgreSQL wird gesichert (Patientendaten, Fallakten, Audit-Log —
# die einzigen nicht regenerierbaren Daten). Neo4j/ChromaDB lassen sich
# jederzeit per KBV-Import neu aufbauen. Dumps liegen im backup_data-
# Volume; Wiederherstellung über docker/restore.sh.
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# ── E-Mail (Passwort-Reset) ─────────────────────────────────────────
# Optional. Wenn SMTP_HOST leer bleibt, wird "Passwort vergessen" zwar
# angenommen (kein Auskunfts-Leck über existierende Konten), aber es
# wird keine Mail verschickt — nur ins Log geloggt. Air-Gap-Betrieb
# funktioniert also weiterhin ohne SMTP, nur eben ohne Self-Service-Reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=EBM Analyzer <noreply@example.org>
# Öffentliche URL der App, für Links in E-Mails (Passwort-Reset).
PUBLIC_BASE_URL=http://localhost:8080

# ── Error tracking (optional) ────────────────────────────────────────
# Leer = deaktiviert (nur Container-Logs). Auf einen selbst gehosteten
# Sentry/GlitchTip-DSN zeigen, um souverän zu bleiben — kein SaaS-Zwang.
SENTRY_DSN=

# ── Valkey / Redis ──────────────────────────────────────────────────
VALKEY_PASSWORD=CHANGE_ME_valkey_password

# ── ChromaDB ────────────────────────────────────────────────────────
CHROMA_TOKEN=CHANGE_ME_chroma_token

# ── Neo4j ───────────────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_neo4j_password

# ── MCP Server ──────────────────────────────────────────────────────
MCP_SECRET=CHANGE_ME_mcp_shared_secret

# ── FastAPI / JWT ───────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_jwt_secret_at_least_32_chars_long
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Nur auf "true" setzen, wenn TLS vor der App terminiert wird (Reverse
# Proxy o.ä.) - sonst verwerfen Browser das Session-Cookie stillschweigend.
COOKIE_SECURE=false

# ── Interner MCP-Kanal ──────────────────────────────────────────────
# Shared Secret fuer den container-internen Kanal MCP-Server -> FastAPI.
INTERNAL_API_KEY=CHANGE_ME_internal_key_at_least_32_chars_long
APP_INTERNAL_URL=http://app:8000

# ── App ─────────────────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8080
ENVIRONMENT=production
LOG_LEVEL=INFO
SESSION_TTL_SECONDS=3600

# ── LLM (Standard: Ollama lokal/air-gapped) ─────────────────────────
# Für Ollama (empfohlen, air-gapped):
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text

# Für Moe Sovereign API (Standard-Konfiguration):
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.moe-sovereign.org/v1
# OPENAI_MODEL=qwen3.6:35b@N04-RTX
# OPENAI_API_KEY=changeme_openai_api_key

# Für Ollama (air-gapped, kein externer API-Zugriff):
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.1:8b
